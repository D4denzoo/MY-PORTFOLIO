# Server. Render sets PORT automatically.
PORT=5000

# Optional. Raises the GitHub API rate limit.
GITHUB_TOKEN=

# Required. resend or gmail. There is no automatic fallback.
EMAIL_PROVIDER=resend

# Required when EMAIL_PROVIDER=resend. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional sender. Leave unset to use Portfolio <onboarding@resend.dev>.
# That address can deliver only to the Resend account email until a domain is verified.
# After the domain is verified, set CONTACT_FROM on Render, for example:
# CONTACT_FROM=Portfolio <hello@your-verified-domain>
CONTACT_TO=denzelosward109@gmail.com

# Used only when EMAIL_PROVIDER=gmail. Requires a Google App Password.
EMAIL_USER=
EMAIL_PASS=

# Optional. Required only for GET /api/messages
ADMIN_SECRET=
