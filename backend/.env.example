# Server. Render sets PORT automatically.
PORT=5000

# Optional. Raises the GitHub API rate limit.
GITHUB_TOKEN=

# Preferred mail path. Create a key at https://resend.com/api-keys
# Sign up with denzelosward109@gmail.com. Until a domain is verified,
# Resend delivers only to that account from onboarding@resend.dev.
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
CONTACT_TO=denzelosward109@gmail.com

# Optional Gmail SMTP. Requires a Google App Password, not the normal Gmail password.
# Used only when RESEND_API_KEY is empty.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=

# Optional. Required only for GET /api/messages
ADMIN_SECRET=
